{
	"name": "@santan/shared",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		}
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"zod": "^4.5.1"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"typescript": "^7.0.2"
	}
}
